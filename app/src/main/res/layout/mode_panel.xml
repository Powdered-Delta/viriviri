<?xml version="1.0" encoding="utf-8" ?>
<ScrollView
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/layout_bg"
  android:clipToOutline="true"
  android:scrollbars="vertical"
  android:fillViewport="true"
>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="20dp"
  >
    <TextView
      android:id="@+id/current_media_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:gravity="center"
      android:lines="1"
      android:text="@string/detail_no_video"
      android:textColor="@android:color/white"
      android:textSize="18sp"
      android:textStyle="bold"
    />
    <TextView
      android:id="@+id/current_media_detail"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:ellipsize="end"
      android:gravity="center"
      android:lines="1"
      android:text="@string/detail_browse_choose"
      android:textColor="#B3FFFFFF"
      android:textSize="12sp"
    />
    <Button
      android:id="@+id/retry_media_button"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:text="@string/retry"
      android:visibility="gone"
    />
    <Button
      android:id="@+id/display_ratio_button"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:text="@string/display_ratio_auto"
    />
    <Button
      android:id="@+id/canvas_size_button"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:text="@string/canvas_size_standard_label"
    />
    <View
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:layout_marginTop="10dp"
      android:background="#33FFFFFF"
    />

    <!-- Debug telemetry (merged from the standalone debug panel): live danmaku stream + stage scale. -->
    <TextView
      android:id="@+id/stage_y_text"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:textSize="13sp"
      android:fontFamily="monospace"
      android:textColor="#B3FFFFFF"
      android:text="Stage Y: --"
    />
    <TextView
      android:id="@+id/danmaku_status"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:textSize="13sp"
      android:fontFamily="monospace"
      android:textColor="#B3FFFFFF"
      android:text="danmaku: idle"
    />
    <TextView
      android:id="@+id/scale_text"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:textSize="13sp"
      android:textColor="#B3FFFFFF"
      android:text="Scale: 1.00"
    />
    <SeekBar
      android:id="@+id/scale_bar"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:progress="500"
      android:max="1000"
    />
    <Button
      android:id="@+id/reset_stage_y_button"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:text="Reset Y (stage height)"
      android:textSize="12sp"
    />
    <View
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:layout_marginTop="10dp"
      android:background="#33FFFFFF"
    />
    <!-- Curvature is per layer: point at the stage and push the right thumbstick left/right to bend
         the target layer, up/down to resize every layer. The button picks the target layer. -->
    <TextView
      android:id="@+id/curvature_text"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:fontFamily="monospace"
      android:textSize="12sp"
      android:textColor="#B3FFFFFF"
      android:text="Curve target: video\n  video:    flat\n  danmaku:  flat\n  backdrop: flat"
    />
    <Button
      android:id="@+id/reset_curve_button"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:text="Reset curve (all layers flat)"
      android:textSize="12sp"
    />
    <!-- Steps the danmaku layer's authored local Z through the candidates; 1 cm is too little to settle
         the draw order against the video's compositor layer, so the working separation is read off the
         headset instead of guessed. Current value is shown in curvature_text. -->
    <Button
      android:id="@+id/danmaku_z_button"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:text="Danmaku Z (cycle)"
      android:textSize="12sp"
    />

    <TextView
      android:id="@+id/debug_build_label"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:gravity="center"
      android:textColor="#B3FFFFFF"
      android:textSize="11sp"
      android:visibility="gone"
    />
    <TextView
      android:id="@+id/debug_aspect_detail"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:gravity="center"
      android:textColor="#B3FFFFFF"
      android:textSize="10sp"
      android:visibility="gone"
    />
    <Button
      android:id="@+id/debug_aspect_target_button"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:text="Target: Default"
      android:visibility="gone"
    />
    <Button
      android:id="@+id/debug_aspect_plan_button"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:text="Plan: Plan 1"
      android:visibility="gone"
    />
    <Button
      android:id="@+id/debug_aspect_apply_button"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:text="Apply"
      android:visibility="gone"
    />
    <Button
      android:id="@+id/open_2d_button"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:text="@string/open_2d"
    />
  </LinearLayout>
</ScrollView>
