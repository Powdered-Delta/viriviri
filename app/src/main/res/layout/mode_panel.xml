<?xml version="1.0" encoding="utf-8" ?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:gravity="center"
  android:background="@drawable/layout_bg"
  android:padding="20dp"
>
  <TextView
    android:id="@+id/current_media_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:gravity="center"
    android:lines="1"
    android:text="No video selected"
    android:textColor="@android:color/white"
    android:textSize="18sp"
    android:textStyle="bold"
  />
  <TextView
    android:id="@+id/current_media_detail"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:ellipsize="end"
    android:gravity="center"
    android:lines="1"
    android:text="Browse to choose a video"
    android:textColor="#B3FFFFFF"
    android:textSize="12sp"
  />
  <Button
    android:id="@+id/retry_media_button"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:text="Retry"
    android:visibility="gone"
  />
  <Button
    android:id="@+id/display_ratio_button"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="Display ratio: Auto"
  />
  <TextView
    android:id="@+id/debug_build_label"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:gravity="center"
    android:textColor="#B3FFFFFF"
    android:textSize="11sp"
    android:visibility="gone"
  />
  <TextView
    android:id="@+id/debug_aspect_detail"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:gravity="center"
    android:textColor="#B3FFFFFF"
    android:textSize="10sp"
    android:visibility="gone"
  />
  <Button
    android:id="@+id/debug_aspect_target_button"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:text="Target: Default"
    android:visibility="gone"
  />
  <Button
    android:id="@+id/debug_aspect_plan_button"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:text="Plan: Plan 1"
    android:visibility="gone"
  />
  <Button
    android:id="@+id/debug_aspect_apply_button"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:text="Apply"
    android:visibility="gone"
  />
  <Button
    android:id="@+id/open_2d_button"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:text="Open 2D Window"
  />
</LinearLayout>
