# Meta Spatial Editor local state
app/scenes/Main.localsettings

temp/grab-bar-archive/


.pi-web/
temp/

# dsh-project-kanban board state (per-workspace local agent state, same class
# as .pi-web/). Un-ignored, every card edit dirties the tree and blocks
# /finish-work; `git add -f` if the board is ever intentionally versioned.
.dsh-kanban.json
.dsh-kanban.json.bak-*

# Penpot workflow generated artifacts (see tools/penpot-workflow/README.md).
# These are produced by extract-panels.ps1 / diff-panels.mjs. Regenerate with
# those scripts; `git add -f out/panel-snapshot.json` if a design snapshot is
# ever intentionally versioned for review.
out/
tools/penpot-workflow/cred.json
tools/penpot-workflow/node_modules/
tools/penpot-workflow/shots/
tools/penpot-workflow/*.log

# Project-local third-party agent skill (dev-god 1.2.4, installed from a local
# zip, not vendored). The tracked skills under .agents/skills/ are this repo's
# own hz-* set; this one is machine-local agent tooling. `git add -f` if it is
# ever intentionally shared.
.agents/skills/dev-god/

# Local MCP client config. Per-user credentials live here (the Penpot entries
# carry a user token), so this file stays out of version control. The shareable
# shape — metavr, ida-pro-mcp, and the Penpot entries with a placeholder token —
# is tracked as `mcp.example.json`; copy it and fill in your own token.
mcp.json

.trellis/

# Local diagram design skill
.agents/skills/diagram-design/

# Pinned offline Japanese engine distributed with Wolvic.
!input-method-engine/vendor-maven/org/wolvic/thirdparty/openwnn/1.3.7/openwnn-1.3.7.aar
