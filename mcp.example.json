{
  "mcpServers": {
    "metavr": {
      "args": [
        "-y",
        "metavr@latest",
        "mcp",
        "server"
      ],
      "command": "npx"
    },
    "ida-pro-mcp": {
      "type": "http",
      "url": "http://127.0.0.1:13337/mcp"
    },
    "penpot": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://penpot.example.com/mcp/stream?userToken=<YOUR_PENPOT_USER_TOKEN>",
        "--transport",
        "http-only"
      ]
    },
    "penpot-http": {
      "type": "http",
      "url": "https://penpot.example.com/mcp/stream?userToken=<YOUR_PENPOT_USER_TOKEN>"
    }
  }
}
